# ========================================================
# Google Gemini AI API Configuration (Render & Production)
# ========================================================
# Cấu hình biến môi trường trên Render Dashboard:
# 1. Đi tới Render Dashboard -> Chọn Web Service của bạn
# 2. Chọn tab "Environment" -> Click "Add Environment Variable"
# 3. Thêm GEMINI_API_KEY với mã API Key của nhà phát triển (lấy từ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy..."

# (Tùy chọn) Khóa API phụ để kích hoạt Hệ Thống Failover Kép chống 429 Quota:
# GEMINI_API_KEY_2="AIzaSy..."

# Cổng khởi chạy máy chủ (Render tự động cung cấp $PORT)
PORT=3000
